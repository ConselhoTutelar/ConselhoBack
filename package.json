{
  "name": "conselho-back",
  "version": "1.0.0",
  "description": "Back-end da aplicação Conselho Tutelar",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:db": "docker compose up -d db",
    "migrate": "node src/database/migrate.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/zero_trust_migration.js",
    "migrate:create": "node scripts/create-migration.js",
    "db:init": "node scripts/init-db.js",
    "test:e2e": "node scripts/test-integration.js",
    "test": "node scripts/test-integration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.3"
  }
}
