# ==============================================================================
# Ambiente e Servidor
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# Configurações do Banco de Dados (MySQL Local ou TiDB Cloud Serverless)
# ==============================================================================
# Para TiDB Cloud Serverless, use:
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=<prefixo>.root
# DB_PASSWORD=<sua_senha_gerada_no_tidb>
# DB_NAME=conselhotutelar (ou test)
# DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=conselhotutelar
DB_USER=conselho_user
DB_PASSWORD=conselhopassword
DB_SSL=false

# Senha de root do MySQL (utilizada na criação do container Docker local)
DB_ROOT_PASSWORD=rootpassword

# ==============================================================================
# Configurações de CORS (origens permitidas separadas por vírgula)
# Obs: domínios *.vercel.app já são aceitos automaticamente
# ==============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Segurança & Autenticação (Zero-Trust JWT)
# ==============================================================================
JWT_SECRET=conselho_tutelar_panambi_rs_zero_trust_jwt_secret_key_2026
JWT_EXPIRES_IN=8h

# ==============================================================================
# Parâmetros de Auditoria & Compliance
# ==============================================================================
MANDATO_VIGENTE=Gestão 2024-2027
